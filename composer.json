{
    "name":"asconsulting/contao-zyppy-page",
    "description":"A module for the Contao CMS to allow for page image and teasers and a corresponding page list module.",
    "homepage": "https://andrewstevens.consulting",
    "keywords":["contao", "page", "description", "image", "data"],
    "type":"contao-bundle",
    "license":"AGPL-3.0-only",
    "authors":[
        {
            "name":"Andrew Stevens",
            "homepage":"https://andrewstevens.consulting"
        }
    ],
    "require":{
        "php": "^8.1",
        "contao/core-bundle": ">=5.3"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0 || ^12.0",
        "contao/test-case": ">=5.3"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Zyppy\\Page\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zyppy\\Page\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
	"extra": {
		"contao-manager-plugin": "Zyppy\\Page\\ContaoManager\\Plugin"
	}
}
